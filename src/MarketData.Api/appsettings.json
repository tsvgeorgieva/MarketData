{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Binance": {
    "WebSocketUrl": "wss://data-stream.binance.vision"
  },
  "Symbols": {
    "Seed": [ "BTCUSDT", "ADAUSDT", "ETHUSDT" ]
  },
  "AllowedHosts": "*"
}
